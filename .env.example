# Copy to .env and fill in. .env is gitignored and must NEVER be committed.
#
# Generate the master key with:
#   python -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"

# 32 random bytes, base64. Required -- startup fails without it.
SCP_MASTER_KEY=

# Optional. When absent the mock provider is used and nothing leaves the process.
ANTHROPIC_API_KEY=

SCP_LLM_PROVIDER=mock                 # mock | anthropic
SCP_LLM_MODEL=claude-opus-5           # see README -> Deviations
SCP_STRATEGY=tokenization             # tokenization | pseudonymization (overridable per request)
SCP_SESSION_TTL_SECONDS=3600
SCP_DATA_DIR=./data

# score >= obfuscate            -> replace via the configured strategy
# redact <= score < obfuscate   -> replace with [REDACTED_<TYPE>], no vault entry
# score <  redact               -> ignore
SCP_THRESHOLD_OBFUSCATE=0.5
SCP_THRESHOLD_REDACT=0.3

# env | mock_kms  -- mock_kms demonstrates KMS envelope semantics locally
SCP_KEY_PROVIDER=env
